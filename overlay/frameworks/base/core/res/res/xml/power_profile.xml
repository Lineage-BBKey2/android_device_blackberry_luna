<device name="Android">
    <!-- All values are in mA except as noted -->
    <item name="none">0</item>
    <item name="screen.on">90</item>
    <item name="screen.full">300</item>
    <!-- Additional power used when Wi-Fi is turned on but not receiving,
         transmitting, or scanning -->
    <item name="wifi.on">1.7</item>
    <!-- Additional power used when transmitting or receiving over Wi-Fi -->
    <item name="wifi.active">104</item>
    <!-- Additional power used when Wi-Fi is scanning for access points -->
    <item name="wifi.scan">120</item>
    <!-- Average power use by the camera subsystem -->
    <item name="camera.avg">350</item>
    <!-- Average power used by the camera flash module when on -->
    <item name="camera.flashlight">180</item>
    <!-- Additional power used when GPS is acquiring a signal -->
    <item name="gps.on">50</item>
    <!-- Additional power used when cellular radio is transmitting/receiving -->
    <item name="radio.active">164</item>
    <!-- The current consumed by the radio when it is scanning for a signal -->
    <item name="radio.scanning">73</item>
    <!-- Current consumed by the radio at different signal strengths, when paging -->
    <array name="radio.on">
        <value>33.079</value>
        <value>30</value>
        <value>25</value>
        <value>20</value>
        <value>15</value>
        <value>10</value>
        <value>5</value>
        <value>1.090</value>
    </array>
    <!-- Number of cores each CPU cluster contains -->
    <array name="cpu.clusters.cores">
        <value>4</value> <!-- Cluster 0 has 4 cores (cpu0, cpu1, cpu2, cpu3) Kryo 260 Silver -->
        <value>4</value> <!-- Cluster 1 has 4 cores (cpu4, cpu5, cpu6, cpu7) Kryo 260 Gold -->
    </array>
    <!-- Cluster 0: Kryo 260 Silver cores, frequencies verified via cpufreq on device -->
    <array name="cpu.core_speeds.cluster0">
        <value>633600</value>   <!-- 633 MHz -->
        <value>902400</value>   <!-- 902 MHz -->
        <value>1113600</value>  <!-- 1113 MHz -->
        <value>1401600</value>  <!-- 1401 MHz -->
        <value>1536000</value>  <!-- 1536 MHz -->
        <value>1612800</value>  <!-- 1612 MHz -->
    </array>
    <!-- Cluster 1: Kryo 260 Gold cores, frequencies verified via cpufreq on device -->
    <array name="cpu.core_speeds.cluster1">
        <value>1113600</value>  <!-- 1113 MHz -->
        <value>1401600</value>  <!-- 1401 MHz -->
        <value>1747200</value>  <!-- 1747 MHz -->
        <value>1804800</value>  <!-- 1804 MHz -->
    </array>
    <!-- Cluster 0 power: estimated from Fairphone 3 (SD632, same Silver core arch),
         interpolated to luna's actual frequencies. Approximate only. -->
    <array name="cpu.core_power.cluster0">
        <value>8.5</value>   <!-- 633 MHz -->
        <value>19.0</value>  <!-- 902 MHz -->
        <value>22.0</value>  <!-- 1113 MHz -->
        <value>29.0</value>  <!-- 1401 MHz -->
        <value>48.57</value> <!-- 1536 MHz -->
        <value>50.0</value>  <!-- 1612 MHz -->
    </array>
    <!-- Cluster 1 power: estimated from athena/SD660 (same Kryo 260 Gold core arch),
         interpolated to luna's actual frequencies. Approximate only. -->
    <array name="cpu.core_power.cluster1">
        <value>31.57</value>  <!-- 1113 MHz -->
        <value>50.96</value>  <!-- 1401 MHz -->
        <value>95.0</value>   <!-- 1747 MHz, interpolated -->
        <value>100.25</value> <!-- 1804 MHz -->
    </array>
    <!-- Additional power consumption by CPU cluster itself when running,
         excluding cores. Values from Fairphone 3 (SD632), approximate. -->
    <item name="cpu.cluster_power.cluster0">4.27</item>
    <item name="cpu.cluster_power.cluster1">7.22</item>
    <!-- Power consumption when CPU is suspended -->
    <item name="cpu.suspend">3.993</item>
    <!-- Additional power consumption when CPU is in a kernel idle loop -->
    <item name="cpu.idle">2.969</item>
    <!-- Additional power consumption by CPU excluding cluster and core when running -->
    <item name="cpu.active">3.5</item>
    <!-- Battery capacity in mAh -->
    <item name="battery.capacity">3000</item>
</device>
